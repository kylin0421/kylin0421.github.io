---
layout: null
permalink: /knowledge.json
sitemap: false
---
{
  "version": {{ site.time | date_to_xmlschema | jsonify }},
  "owner": {{ site.author.name | jsonify }},
  "bio": {{ site.author.bio | jsonify }},
  "links": {{ site.author.links | jsonify }},
  "documents": [
    {% assign about = site.pages | where: 'permalink', '/about/' | first %}
    {"title": "About Linxiang Su", "url": "/about/", "kind": "profile", "content": {{ about.content | markdownify | strip_html | normalize_whitespace | jsonify }}}
    {% for post in site.posts %},
    {"title": {{ post.title | jsonify }}, "url": {{ post.url | relative_url | jsonify }}, "date": {{ post.date | date: '%Y-%m-%d' | jsonify }}, "kind": "post", "tags": {{ post.tags | jsonify }}, "content": {{ post.content | markdownify | strip_html | normalize_whitespace | jsonify }}}
    {% endfor %}
  ]
}
